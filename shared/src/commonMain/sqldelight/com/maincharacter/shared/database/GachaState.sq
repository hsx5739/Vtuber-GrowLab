import com.maincharacter.shared.model.GachaState;

CREATE TABLE GachaState (
    pool_id TEXT NOT NULL PRIMARY KEY,
    pity_counter INTEGER NOT NULL DEFAULT 0
);

selectByPoolId:
SELECT * FROM GachaState WHERE pool_id = ?;

insert:
INSERT OR REPLACE INTO GachaState(pool_id, pity_counter)
VALUES (?, ?);
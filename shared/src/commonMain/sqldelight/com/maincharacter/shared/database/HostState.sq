import com.maincharacter.shared.model.HostState;

CREATE TABLE HostState (
    fortune INTEGER NOT NULL DEFAULT 0,
    vitality INTEGER NOT NULL DEFAULT 50,
    mood INTEGER NOT NULL DEFAULT 50,
    bond INTEGER NOT NULL DEFAULT 0,
    focus INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM HostState LIMIT 1;

insert:
INSERT OR REPLACE INTO HostState(fortune, vitality, mood, bond, focus)
VALUES (?, ?, ?, ?, ?);